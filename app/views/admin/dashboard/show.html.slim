- content_for :title, t("admin.dashboard.title")
section.card
  h1 = t("admin.dashboard.title")
  dl
    dt = t("attributes.site_name")
    dd = @site.name
    dt = t("attributes.domain")
    dd = @site.domain
  - if @site.interview_pending?
    p.lead = t("admin.dashboard.interview_pending")
    = link_to t("admin.dashboard.continue_interview"), admin_interview_path, class: "button"
  - elsif @top_page.nil? || @top_page.generating?
    p.lead = t("admin.dashboard.generating")
  - elsif @top_page.published?
    p.lead = t("admin.dashboard.published")
    = link_to t("admin.dashboard.view_page"), admin_content_item_path(@top_page), class: "button"
  - else
    p.lead = t("admin.dashboard.generation_failed")
    = button_to t("content.regenerate"), regenerate_admin_content_item_path(@top_page), method: :post

/ What the month's spend bought, in outcomes. No tokens, no model names, no
/ thresholds: the owner is never asked to predict usage (README §33).
section.card.usage
  h2 = t("admin.usage.heading")
  p.lead = t("admin.usage.pages", count: @usage.pages_this_month)
  - if @usage.estimated?
    p = t("admin.usage.estimated", count: @usage.remaining_pages)
  - else
    p = t("admin.usage.remaining", count: @usage.remaining_pages)
  - spent = number_with_precision(@usage.spent, precision: 2)
  - limit = number_with_precision(@usage.limit, precision: 0)
  p.amount = t("admin.usage.amount", spent: spent, limit: limit)
  - if @usage.degraded?
    p.degraded = t("admin.usage.degraded")
